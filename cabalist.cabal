cabal-version:      3.4
name:               cabalist
version:            0.1.0.0
synopsis:           A GUI for making Hackage releases, including from monorepos
description:
    cabalist finds the Cabal packages in a git repository, including those in
    subdirectories of a monorepo, and shows where each one stands: its tag,
    changes since its last release, and what Hackage has. From there it runs a
    cautious, stepped release in the style of hkgr: tag and sdist from a
    pristine checkout, a pristine build of the tarball, candidate uploads, and
    finally publishing the release and its documentation.
license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
category:           Development, Distribution
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md

common shared
    default-language: GHC2024
    default-extensions:
        OverloadedStrings
        LambdaCase
    ghc-options: -Wall -Wcompat -Widentities -Wunused-packages

-- Release logic, independent of the GUI.
library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:
        Cabalist.Config
        Cabalist.File
        Cabalist.Git
        Cabalist.Hackage
        Cabalist.Package
        Cabalist.Process
        Cabalist.Release
        Cabalist.Status
        Cabalist.Version
    build-depends:
        base >=4.20 && <5,
        bytestring >=0.11 && <0.13,
        Cabal-syntax >=3.10 && <3.18,
        containers >=0.6 && <0.9,
        directory >=1.3.7 && <1.4,
        filepath >=1.4 && <1.6,
        process >=1.6.9 && <1.7,
        text >=2.0 && <2.2,
        time >=1.12 && <1.16

executable cabalist
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    other-modules:
        Gui.SelfTest
        Gui.State
        Gui.Style
        Gui.View
    build-depends:
        base,
        cabalist,
        containers,
        directory,
        filepath,
        nano-ui ^>=0.1,
        nano-ui-sdl ^>=0.1,
        process,
        text
    ghc-options: -threaded -rtsopts "-with-rtsopts=-N2 -I0"

test-suite cabalist-test
    import:           shared
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:
        base,
        cabalist,
        directory,
        filepath,
        text
    ghc-options: -threaded
